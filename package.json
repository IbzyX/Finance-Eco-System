{
  "name": "finance-ecosystem",
  "private": true,
  "workspaces": [
    "backend",
    "frontend-finance-tracker-v2",
    "frontend-stock-news-feed"
  ],
  "scripts": {
    "start:backend": "npm run dev --workspace=backend",
    "start:finance": "npm run dev --workspace=frontend-finance-tracker-v2",
    "start:news": "npm run dev --workspace=frontend-stock-news-feed",
    "dev": "npx concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend-finance-tracker-v2\" \"npm run dev --workspace=frontend-stock-news-feed\"",
    "install:all": "npm install --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^10.0.1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pdfjs-dist": "^5.4.530",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.7.0"
  }
}
